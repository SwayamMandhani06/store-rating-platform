# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Database - Supabase PostgreSQL
DB_HOST=aws-xxxxx.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxxx
DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD

# Default admin seeded on first run
SEED_ADMIN_NAME=Default System Administrator Account
SEED_ADMIN_EMAIL=admin@storerating.com
SEED_ADMIN_PASSWORD=Admin@1234
SEED_ADMIN_ADDRESS=Head Office, Platform Admin Address